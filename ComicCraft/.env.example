# ============================================================
# ComicCraft Environment Configuration
# ============================================================

# Gemini API key for story and outline generation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Hugging Face API token
HF_API_KEY=your_huggingface_api_key

# Hugging Face image model
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Image provider
IMAGE_PROVIDER=huggingface

# Set true for testing without API calls
MOCK_MODE=false

# Number of comic panels
PANEL_COUNT=5

# Server
HOST=127.0.0.1
PORT=8000